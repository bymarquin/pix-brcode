{
  "name": "brpix",
  "version": "0.3.0",
  "description": "Gera, lê e valida Pix copia-e-cola (BR Code/EMV) e QR Code em TypeScript, zero dependências",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc && tsc -p tsconfig.cjs.json && node scripts/postbuild.js",
    "test": "node --test test/*.test.ts",
    "coverage": "node --test --experimental-test-coverage test/*.test.ts",
    "prepublishOnly": "npm test && npm run build"
  },
  "keywords": [
    "pix",
    "brcode",
    "emv",
    "qrcode",
    "bacen",
    "pagamentos",
    "brasil",
    "qr",
    "qrcode"
  ],
  "license": "MIT",
  "author": "bymarquin",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bymarquin/pix-brcode.git"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "qrcode": "^1.5.4",
    "typescript": "^7.0.2"
  },
  "module": "./dist/esm/index.js",
  "sideEffects": false
}
